---
import Icon from './Icon.astro';
const { product, index = 0 } = Astro.props;
const price = Number.isInteger(product.priceCents) ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(product.priceCents / 100) : 'Ask for pricing';
---
<article class="product-card" data-category={product.category} data-name={[product.name, ...(product.variants || []).map(variant => variant.name)].join(' ').toLowerCase()}>
  <a class="product-photo" href={`/shop/${product.id}/`} aria-label={`View ${product.name}`}>
    <img src={product.images[0]} alt={`${product.name}, photographed as printed`} loading="lazy" width="768" height="1024" style={`object-position:${product.imagePosition};object-fit:${product.imageFit || 'cover'};--photo-scale:${product.imageScale || 1};transform-origin:${product.imageOrigin || product.imagePosition}`} />
    <span class="product-index">{String(index + 1).padStart(2, '0')} / THE COLLECTION</span>
    <span class="product-open"><Icon name="diagonal" /></span>
  </a>
  <div class="product-meta"><span class="eyebrow">{product.variants ? `${product.variants.length} designs` : product.category}</span><span class="product-price">{price}{product.priceCents === 200 && ' each'}</span></div>
  <h3><a href={`/shop/${product.id}/`}>{product.name}</a></h3>
  <p>{product.eyebrow}</p>
</article>
