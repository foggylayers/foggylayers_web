---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FacebookLink from '../components/FacebookLink.astro';
import '../styles/commerce.css';
---
<Layout title="Your shopping bag" noindex>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow kicker">Good things, gathered</p>
      <h1>Your bag.</h1>
      <p class="lede">Choose US shipping or Everett pickup, then pay securely with PayPal.</p>
    </div>
  </section>
  <div class="container">
    <section class="cart-empty" data-cart-empty>
      <Icon name="bag" size={40}/>
      <h2>A little room for something good.</h2>
      <p>Your bag is empty. Find your next print in the collection.</p>
      <a class="button" href="/shop/">Explore the prints <Icon name="arrow" size={17}/></a>
    </section>
    <div class="cart-layout" data-cart-layout hidden>
      <div>
        <div data-cart-items></div>
        <a class="text-link" style="margin-top:25px" href="/shop/">Keep exploring <Icon name="arrow" size={17}/></a>
      </div>
      <aside class="cart-summary" data-paypal-checkout>
        <h2>A few final details.</h2>
        <div class="summary-line"><span>Items subtotal</span><strong data-cart-subtotal></strong></div>
        <fieldset class="choice-row">
          <legend>Delivery preference</legend>
          <label><input type="radio" name="cart-fulfillment" value="shipping" checked/> US shipping</label>
          <label><input type="radio" name="cart-fulfillment" value="pickup"/> Everett pickup</label>
        </fieldset>
        <div class="summary-line"><span>Delivery</span><strong data-cart-shipping>Calculating...</strong></div>
        <div class="summary-line summary-total"><span>Total</span><strong data-cart-total></strong></div>
        <p class="commerce-note" data-minimum-note></p>
        <p class="form-notice" data-paypal-notice role="status">Checking secure checkout...</p>
        <div class="paypal-buttons" aria-label="Payment options">
          <paypal-button type="pay" data-paypal-button hidden></paypal-button>
          <venmo-button type="pay" data-venmo-button hidden></venmo-button>
        </div>
        <p class="form-error" data-paypal-error role="alert" hidden></p>
        <p class="cart-contact"><FacebookLink class="text-link">Ask about your bag on Facebook <Icon name="diagonal" size={16}/></FacebookLink></p>
      </aside>
    </div>
  </div>
  <script>import '../scripts/paypal-checkout.js';</script>
</Layout>
