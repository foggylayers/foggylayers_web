---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FacebookLink from '../../components/FacebookLink.astro';
import products from '../../data/products.json';
const categories = ['All prints', ...new Set(products.map(product => product.category))];
const descriptions = {
 'Christmas': 'Mini glowing figures with battery tealights, Lady Grinch ornaments, outdoor Christmas ornaments, and Microsoft logo designs.',
 'Holiday Minis': 'Little reindeer, snowmen, and green Santa-hat friends for a desk, display, or stocking.',
 'GrinchMas': 'Six Grinch ornament designs and a stained glass style Grinch decoration for a little holiday mischief.',
 'Mini Pets': 'Mix mini dragons and animal friends in one collection: $3 each or 5 for $20.',
 'Small figures': 'Little characters for your shelf or desk, priced individually.',
 'Keychains': 'Little characters to take along, plus a miniature accessory.',
 'Dragons': 'Longer bodies, sculpted details, and colorful finishes.',
 'Fidgets': 'Spiral helix fidgets and gears are $2 each. Clickers are $3 each or 5 for $20. Explore folding cubes, nested stars, and more.',
 'Home & decor': 'Printed texture and useful shapes for your space.',
 'Signs': 'Bold lettering with a little personality.'
};
---
<Layout title="Shop the prints">
 <section class="page-intro"><div class="container"><p class="breadcrumb"><a href="/">Home</a><span>/</span><span>The collection</span></p><p class="eyebrow kicker">Christmas & curious little things</p><h1>A collection of character.</h1><p class="lede">Spiral helix fidgets and gears are $2 each. Clickers, Holiday Minis, and Mini Flexi Pets are $3 each or 5 for $20 within each collection. Explore the new Christmas collection, ornaments, larger dragons, and more below.</p></div></section>
 <section class="container catalog-section" aria-label="Product collection"><div class="shop-toolbar"><div class="filters" aria-label="Filter products">{categories.map((label,index)=><button class="filter-button" data-filter={index === 0 ? 'all' : label} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}</div><label><span class="eyebrow" style="display:block;font-size:8px">Find a print</span><input type="search" class="search-input" placeholder="Try fox, dragon, or pumpkin…" data-shop-search aria-label="Search products"/></label></div>{categories.slice(1).map(label=><section class="catalog-group" data-product-group aria-label={label}><div class="catalog-group-heading"><h2>{label === 'Christmas' ? <a href="/shop/christmas/">Christmas</a> : label === 'GrinchMas' ? <a href="/shop/grichmas/">GrinchMas ↗</a> : label === 'Fidgets' ? <a href="/shop/fidgets/">Fidgets ↗</a> : label}</h2><p>{descriptions[label]}</p></div><div class="product-grid" data-product-grid>{products.filter(product=>product.category===label).sort((a,b)=>Number(b.images.length>0)-Number(a.images.length>0)).map(product=><ProductCard product={product} index={products.indexOf(product)}/>)}</div></section>)}<p class="catalog-empty" data-catalog-empty role="status" hidden>No prints match that search. Try another name or choose All prints.</p><div class="collection-foot"><span>Have something else in mind?</span><FacebookLink>Ask about a custom print on Facebook ↗</FacebookLink></div></section>
</Layout>

