---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import products from '../../data/products.json';
export function getStaticPaths() { return products.map(product => ({params:{slug:product.id},props:{product}})); }
const { product } = Astro.props;
const purchasable = product.status === 'available' && Number.isInteger(product.priceCents) && product.priceCents >= 50;
const price = purchasable ? new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(product.priceCents/100) : 'Ask us for pricing & availability';
const photoStyle = `object-position:${product.imagePosition};object-fit:${product.imageFit || 'cover'};--photo-scale:${product.imageScale || 1};transform-origin:${product.imageOrigin || product.imagePosition}`;
---
<Layout title={product.name} description={product.description}>
 <section class="container product-detail" data-product-detail={product.id}>
  <p class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/shop/">The collection</a><span>/</span><span>{product.name}</span></p>
  <div class="product-layout">
   <div class="product-gallery">
    <button class="product-main-image" data-photo-zoom aria-label={`Enlarge photo of ${product.name}`}><img src={product.images[0]} alt={product.name} data-main-photo width="768" height="1024" style={photoStyle}/></button>
    {product.images.length > 1 && <div class="thumbs" aria-label="Product photographs">{product.images.map((src,index) => {
     const variant = product.variants?.find(variant => variant.image === src);
     return <button data-photo-src={src} data-photo-variant={variant?.id} aria-pressed={index===0?'true':'false'} aria-label={variant ? `View ${variant.name}` : `View photo ${index+1} of ${product.name}`}><img src={src} alt="" width="76" height="88" loading="lazy"/></button>;
    })}</div>}
    <p class="privacy-note">Actual product photographs. Click the image for a closer look.</p>
    {product.videos?.map(video => <figure class="product-video"><video controls playsinline preload="none" poster={video.poster || product.images[0]} aria-label={video.caption}><source src={video.src} type="video/mp4"/>Your browser does not support this video.</video><figcaption>{video.caption}</figcaption></figure>)}
   </div>
   <div class="detail-copy">
    <p class="eyebrow">{product.category} / Foggy Layers</p><h1>{product.name}</h1>
    <p class="detail-price">{price}{purchasable && <span> each</span>}</p><p class="detail-description">{product.description}</p>
    {product.variants && <label class="variant-field">{product.variantLabel}<select data-product-variant required={purchasable} aria-label={product.variantLabel}><option value="">Select a design…</option>{product.variants.map(variant => <option value={variant.id}>{variant.name}</option>)}</select></label>}
    <dl class="detail-specs"><div><dt>Shown in</dt><dd data-selected-design>{product.color}</dd></div><div><dt>Size</dt><dd>{product.size || 'Please ask for details'}</dd></div><div><dt>Material</dt><dd>{product.material || 'Please ask for details'}</dd></div><div><dt>Getting it to you</dt><dd>Shipping or Everett pickup</dd></div></dl>
    {purchasable ? <>
     <label class="quantity-field">Quantity<span class="quantity-controls"><button data-quantity-step="-1" type="button" aria-label="Decrease quantity"><Icon name="minus" size={14}/></button><input id="product-quantity" type="number" min="1" max="20" value="1" aria-label="Quantity"/><button data-quantity-step="1" type="button" aria-label="Increase quantity"><Icon name="plus" size={14}/></button></span></label>
     <button class="button" data-add-product={product.id}>Add to bag <Icon name="bag" size={18}/></button><p data-add-status role="status" class="privacy-note"></p>
    </> : <a class="button" data-product-inquiry href={`/project/?type=product&product=${product.id}`}>Ask about this print <Icon name="arrow" size={18}/></a>}
    <p class="delivery-note"><Icon name="pin" size={16}/> Local pickup in Everett, Washington</p>
    <div class="detail-faq"><details><summary>Can I request a different size or color?</summary><p>Tell us what you have in mind. We'll check what's possible and confirm any change in price before printing.</p></details><details><summary>How does pickup work?</summary><p>Choose local pickup with your request or order. We'll share collection details when your print is ready.</p></details><details><summary>When will my print be ready?</summary><p>We'll confirm availability and timing with you. Custom work is reviewed before we commit to a print date.</p></details></div>
   </div>
  </div>
 </section>
 <dialog class="zoom-dialog" data-zoom-dialog aria-label="Enlarged product photograph"><button data-close-zoom aria-label="Close photo"><Icon name="close"/></button><img src={product.images[0]} alt={`Enlarged photo of ${product.name}`} data-zoom-photo/></dialog>
</Layout>
