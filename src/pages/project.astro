---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FacebookLink from '../components/FacebookLink.astro';
---
<Layout title="Contact Foggy Layers" description="Message Foggy Layers on Facebook about printed figures, custom 3D printing, design help, shipping, or Everett pickup.">
  <section class="page-intro"><div class="container">
    <p class="breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></p>
    <p class="eyebrow kicker">Let's make something</p>
    <h1>Let's talk on Facebook.</h1>
    <p class="lede">Ask about a print, share an idea, or discuss a custom project. Message our Facebook Page and we'll work through the details with you.</p>
  </div></section>
  <section class="container project-layout" aria-label="Contact Foggy Layers">
    <aside class="project-aside">
      <h2>Start wherever you are.</h2>
      <p>A finished model, a rough sketch, or a print you spotted in the collection. Tell us what you have in mind.</p>
      <div class="aside-note"><strong>A quote before a commitment.</strong><p>We'll review size, quantity, color, pricing, and timing with you before any work begins.</p></div>
      <div class="aside-note"><strong>Shipping or local pickup.</strong><p>Let us know what works for you. Local pickup is available in Everett, Washington.</p></div>
    </aside>
    <div class="project-form facebook-contact">
      <p class="eyebrow kicker">Foggy Layers on Facebook</p>
      <h2>Say hello.</h2>
      <p>Open our Facebook Page and choose Message to start a conversation with Foggy Layers.</p>
      <FacebookLink class="button">Open our Facebook Page <Icon name="diagonal" size={18}/></FacebookLink>
      <p class="privacy-note">Include the print or project name, desired size, quantity, and color. If you have a 3D model, tell us about the file and we'll arrange how to share it.</p>
    </div>
  </section>
</Layout>
