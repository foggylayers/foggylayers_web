{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foggylayers",
  "main": "worker/entry.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "exports": {
    "FacebookPublisher": { "type": "durable-object", "storage": "sqlite" }
  },
  "previews": {},
  "vars": {
    "SITE_URL": "https://foggylayers.com",
    "REQUESTS_ENABLED": "false",
    "COMMERCE_ENABLED": "false",
    "FACEBOOK_PUBLISHING_ENABLED": "false",
    "FACEBOOK_API_VERSION": "v26.0",
    "SHIPPING_COUNTRIES": "US"
  }
}
